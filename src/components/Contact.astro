---
import { MapPin, Phone, Mail, Clock, MessageCircle } from "lucide-react";
---

<section id="contacto" class="relative overflow-hidden bg-gradient-to-b from-teal-50 to-white py-20 px-6 md:px-16">
<!-- Imagen de fondo fija y opaca -->
  <div class="absolute inset-0 bg-center bg-cover opacity-30 pointer-events-none"
       style="background-image: url('/hero/cl.jpg'); background-attachment: fixed;">
  </div>
  <div class="relative z-10 max-w-6xl mx-auto">
    <!-- Título -->
    <h2 class="text-4xl md:text-5xl font-extrabold text-center text-teal-600 mb-12 drop-shadow-sm">
      Dónde
      <span class="inline-block bg-teal-500 px-4 py-1.5 rounded-xl text-white shadow-md">
        encontrarnos
      </span>
    </h2>

    <!-- Contenido -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
      
      <!-- Mapa -->
      <div class="rounded-3xl shadow-2xl overflow-hidden border border-teal-100">
        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3507.351696385232!2d-16.259378124193983!3d28.468953275754515!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xc41cc8142e23e89%3A0x52217ad24d010376!2sCl%C3%ADnica%20Barajas!5e0!3m2!1ses!2ses!4v1755937038013!5m2!1ses!2ses" 
        width="600" 
        height="450" style="border:0;" 
        allowfullscreen="" loading="lazy" 
        referrerpolicy="no-referrer-when-downgrade">
        </iframe>
      </div>

      <!-- Tarjeta de información elegante -->
      <div class="bg-white/80 backdrop-blur-md rounded-3xl shadow-2xl p-10 border border-teal-200">
        <h3 class="text-2xl font-bold text-teal-700 mb-8 flex items-center gap-3">
          
          Contacto & Horarios
        </h3>
        <div class="space-y-6 text-teal-800">
          <!-- Dirección -->
          <div class="flex items-start gap-4">
            <MapPin class="h-6 w-6 text-teal-500 mt-1" />
            <p><strong>Dirección:</strong> C. de Pérez de Rozas, 8<br />
              38004 Santa Cruz de Tenerife<br />
              Islas Canarias, España</p>
          </div>
          <!-- Teléfono -->
          <div class="flex items-center gap-4">
            <Phone class="h-6 w-6 text-teal-500" />
            <p><strong>Teléfono:</strong> +34 922 27 54 88</p>
          </div>
          <div class="flex items-center gap-4">
            <MessageCircle class="h-6 w-6 text-teal-500" />
            <p><strong>WhatsApp:</strong> +34 613 003 092</p>
          </div>
          <!-- Correo -->
          <div class="flex items-center gap-4">
            <Mail class="h-6 w-6 text-teal-500" />
            <p><strong>Correo:</strong> clinicabarajas@gmail.com</p>
          </div>
          <!-- Horarios -->
          <div class="flex items-start gap-4">
            <Clock class="h-6 w-6 text-teal-500 mt-1" />
            <div>
              <strong>Horario de atención:</strong>
              <ul class="list-disc list-inside ml-4 mt-1">
                <li>Lunes y Miércoles: 9:00 - 19:00</li>
                <li>Martes, Jueves y Viernes: 9:00 - 17:00</li>
                <li>Sábado: Cerrado</li>
                <li>Domingo: Cerrado</li>
              </ul>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
