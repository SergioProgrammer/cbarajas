---
import Layout from "../layouts/Layout.astro";
import NavBar from "../components/NavBar";
import Audifonos from "../subcomponents/Audifonos.jsx";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.jsx";
import Chatbot from "../components/Chatbot.astro";

const pageTitle = "Audífonos en Tenerife | Clínica Barajas";
const pageDescription =
  "Adaptación de audífonos en Santa Cruz de Tenerife con evaluación auditiva completa y seguimiento personalizado. Clínica Barajas.";
const canonicalUrl = "https://www.clinicabarajas.com/audifonos-tenerife";

const hearingAidsMainSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "MedicalBusiness",
      "@id": "https://www.clinicabarajas.com/audifonos-tenerife/#clinica",
      "name": "Clínica Barajas - Centro Auditivo en Tenerife",
      "url": "https://www.clinicabarajas.com/audifonos-tenerife",
      "image": "https://www.clinicabarajas.com/especialidades/audifonos.webp",
      "telephone": "+34922275488",
      "priceRange": "$$",
      "medicalSpecialty": "Audiology",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "C. de Perez de Rozas, 8",
        "addressLocality": "Santa Cruz de Tenerife",
        "addressRegion": "Canarias",
        "postalCode": "38004",
        "addressCountry": "ES"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 28.46824,
        "longitude": -16.25462
      },
      "description": "Adaptación de audífonos en Santa Cruz de Tenerife con evaluación auditiva completa y seguimiento personalizado en Clínica Barajas."
    },

    {
      "@type": "Service",
      "@id": "https://www.clinicabarajas.com/audifonos-tenerife/#servicio",
      "serviceType": "Audífonos y adaptación auditiva",
      "name": "Audífonos en Santa Cruz de Tenerife",
      "description": "Servicio de evaluación auditiva, adaptación personalizada de audífonos y seguimiento personalizado en Santa Cruz de Tenerife.",
      "provider": {
        "@id": "https://www.clinicabarajas.com/audifonos-tenerife/#clinica"
      },
      "areaServed": {
        "@type": "City",
        "name": "Santa Cruz de Tenerife"
      },
      "availableChannel": {
        "@type": "ServiceChannel",
        "serviceUrl": "https://www.clinicabarajas.com/audifonos-tenerife"
      }
    },

    {
      "@type": "WebPage",
      "@id": "https://www.clinicabarajas.com/audifonos-tenerife/#webpage",
      "url": "https://www.clinicabarajas.com/audifonos-tenerife",
      "name": "Audífonos en Santa Cruz de Tenerife | Clínica Barajas",
      "description": "Adaptación de audífonos en Santa Cruz de Tenerife con evaluación auditiva completa y seguimiento personalizado. Clínica Barajas.",
      "isPartOf": {
        "@type": "WebSite",
        "@id": "https://www.clinicabarajas.com/#website"
      },
      "about": {
        "@id": "https://www.clinicabarajas.com/audifonos-tenerife/#servicio"
      }
    },

    {
      "@type": "BreadcrumbList",
      "@id": "https://www.clinicabarajas.com/audifonos-tenerife/#breadcrumb",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Inicio",
          "item": "https://www.clinicabarajas.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Audífonos",
          "item": "https://www.clinicabarajas.com/audifonos-tenerife"
        }
      ]
    },

    {
      "@type": "FAQPage",
      "@id": "https://www.clinicabarajas.com/audifonos-tenerife/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Cuándo es recomendable utilizar audífonos?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Cuando existe dificultad para comprender conversaciones o se necesita subir mucho el volumen de televisión o teléfono."
          }
        },
        {
          "@type": "Question",
          "name": "¿Es difícil adaptarse a los audífonos?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La adaptación suele ser progresiva. Con ajustes adecuados y seguimiento, la mayoría de los pacientes se acostumbran de forma natural."
          }
        },
        {
          "@type": "Question",
          "name": "¿Es necesario realizar una prueba auditiva?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. La evaluación auditiva permite seleccionar y ajustar el audífono de forma adecuada para cada caso. Y sobre todo saber si es realmente necesario."
          }
        },
        {
          "@type": "Question",
          "name": "¿Dónde comprar audífonos en Tenerife?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Más que el lugar, lo importante es el proceso de evaluación y adaptación. Un mismo audífono puede ofrecer resultados muy distintos según cómo se ajuste."
          }
        }
      ]
    }
  ]
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={canonicalUrl}
  ogTitle={pageTitle}
  ogDescription={pageDescription}
  ogType="article"
  schema={hearingAidsMainSchema}
>
  <NavBar client:load/>
  <div class="pt-16">
  <Audifonos client:load />
  <Contact />
  </div>
  <Chatbot />
  <Footer />
</Layout>
